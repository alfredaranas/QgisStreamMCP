# ═══════════════════════════════════════════════════════════════════
# BigQgisMCP — Environment Configuration
# ═══════════════════════════════════════════════════════════════════

# MCP Server
MCP_PORT=8100

# QGIS Display
QGIS_RESOLUTION=1920x1080x24

# noVNC
VNC_HOST=localhost
QGIS_VNC_PORT=6080

# External vision services (optional, on host machine or elsewhere)
MOONDREAM_URL=http://host.docker.internal:8001
SAMGEO3_URL=http://host.docker.internal:8002
DEPTHPRO_URL=http://host.docker.internal:8003

# REST API auth (store actual values only in .env)
QGIS_API_TOKEN=replace-with-random-bearer-token
QGIS_ELEVATED_TOKEN=replace-with-separate-elevated-token
QGIS_VNC_PASSWORD=replace-with-vnc-password
QGIS_VNC_HTTP_PASSWORD=replace-with-http-basic-password
